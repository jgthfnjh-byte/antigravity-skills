{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KompasToolPartSpecification",
  "description": "Schema for generating 3D parts and 2D drawings in KOMPAS-3D via kompas_tool.py",
  "type": "object",
  "required": [
    "type",
    "operations"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "part",
        "drawing"
      ]
    },
    "title": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "default": "A4"
    },
    "orientation": {
      "type": "string",
      "enum": [
        "vertical",
        "horizontal"
      ],
      "default": "vertical"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "plane",
          "depth",
          "sketch"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "extrude",
              "cut",
              "rotate"
            ]
          },
          "plane": {
            "type": "string",
            "enum": [
              "XOY",
              "XOZ",
              "YOZ"
            ]
          },
          "depth": {
            "type": "number"
          },
          "direction": {
            "type": "string",
            "enum": [
              "normal",
              "reverse",
              "both"
            ],
            "default": "normal"
          },
          "sketch": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "rect",
                    "circle",
                    "line",
                    "arc",
                    "spline"
                  ]
                },
                "x1": {
                  "type": "number"
                },
                "y1": {
                  "type": "number"
                },
                "x2": {
                  "type": "number"
                },
                "y2": {
                  "type": "number"
                },
                "xc": {
                  "type": "number"
                },
                "yc": {
                  "type": "number"
                },
                "radius": {
                  "type": "number"
                },
                "points": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}